erDiagram
    CLIENTES {
        UUID id PK
        string cpf_cnpj UK
    }
    USUARIOS {
        UUID id PK
        string email UK
    }
    PRODUTOS {
        UUID id PK
        string sku UK
        decimal preco_venda
        decimal estoque_fisico
        decimal estoque_minimo
        integer version
    }
    VENDAS {
        UUID id PK
        string numero UK
        UUID cliente_id FK
        UUID usuario_id FK
        string status
        decimal total
        string idempotency_key
    }
    ITENS_VENDA {
        UUID id PK
        UUID venda_id FK
        UUID produto_id FK
        decimal quantidade
        decimal preco_unitario
        decimal desconto
        decimal subtotal
    }
    PAGAMENTOS {
        UUID id PK
        UUID venda_id FK
        string status
        decimal valor
        string transacao_id
    }
    ESTORNOS {
        UUID id PK
        UUID pagamento_id FK
        decimal valor
        string status
    }
    ESTOQUE_RESERVAS {
        UUID id PK
        UUID venda_id FK
        UUID produto_id FK
        decimal quantidade
        string status
        timestamp expiracao
    }
    ESTOQUE_MOVIMENTACOES {
        UUID id PK
        UUID produto_id FK
        UUID usuario_id FK
        string tipo
        decimal quantidade
        decimal estoque_anterior
        decimal estoque_posterior
        UUID referencia_id
    }
    COMPROVANTES {
        UUID id PK
        UUID venda_id FK
        string numero UK
        json snapshot_venda
    }
    CLIENTES ||--o{ VENDAS : realiza
